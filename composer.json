{
    "name": "uams-web/aether-wordpress-importer-cleanup",
    "description": "Deterministic CLI tool to transform WordPress WXR exports — strips legacy <table> markup for Statamic import.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "cweagans/composer-patches": "^2.0",
        "laravel/pint": "^1.29",
        "mrpunyapal/peststan": "^0.2.10",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-drift": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "UAMSWeb\\Aether\\WordPressImporter\\Cleanup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UAMSWeb\\Aether\\WordPressImporter\\Cleanup\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/wxr-cleanup"
    ],
    "extra": {
        "composer-exit-on-patch-failure": true
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "pest",
        "mutate": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/pest --mutate --path=src/Disposition,src/Rule.php,src/Rules,src/Transform.php,src/XpathNodes.php"
        ],
        "refactor": "rector",
        "refactor:sweep": "rector --clear-cache --config=rector-sweep.php",
        "test:refactor": "rector --dry-run",
        "test:refactor:sweep": "rector --dry-run --clear-cache --config=rector-sweep.php",
        "pint": "pint",
        "test:pint": "pint --test",
        "stan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "mutate": "Mutate the src paths that are mutation-clean on Linux and macOS; src/Rules is left out until UAMS-Web/aether-wordpress-importer-cleanup#41 restores --path=src"
    }
}
