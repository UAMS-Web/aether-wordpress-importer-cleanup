#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export DEBIAN_FRONTEND=noninteractive

step() {
    local label="$1"
    shift
    local start=$SECONDS
    printf '\n==> %s\n' "$label"
    "$@"
    printf '==> %s finished in %ss\n' "$label" "$((SECONDS - start))"
}

packages=(ca-certificates curl git unzip php8.4-cli php8.4-curl php8.4-mbstring php8.4-xml php8.4-zip php8.4-pcov)
missing=()
for package in "${packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
        missing+=("$package")
    fi
done

if ((${#missing[@]})); then
    if [[ ! -f /etc/apt/sources.list.d/php.list ]]; then
        step 'Refresh package index' sudo apt-get update -qq
        step 'Install repository prerequisites' sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates curl
        keyring=$(mktemp --suffix=.deb)
        trap 'rm -f "$keyring"' EXIT
        step 'Download PHP repository keyring' curl -fsSL --retry 3 \
            https://packages.sury.org/debsuryorg-archive-keyring.deb -o "$keyring"
        step 'Install PHP repository keyring' sudo dpkg -i "$keyring"
        . /etc/os-release
        printf 'deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ %s main\n' "$VERSION_CODENAME" \
            | sudo tee /etc/apt/sources.list.d/php.list >/dev/null
    fi
    step 'Refresh PHP package index' sudo apt-get update -qq
    step 'Install PHP 8.4 and extensions' sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi

step 'Select PHP 8.4 CLI' sudo update-alternatives --set php /usr/bin/php8.4

if ! command -v composer >/dev/null 2>&1; then
    installer=$(mktemp)
    trap 'rm -f "${keyring:-}" "$installer"' EXIT
    step 'Download Composer installer' curl -fsSL --retry 3 https://getcomposer.org/installer -o "$installer"
    signature=$(curl -fsSL --retry 3 https://composer.github.io/installer.sig)
    if [[ "$(sha384sum "$installer" | cut -d ' ' -f 1)" != "$signature" ]]; then
        echo 'Composer installer signature mismatch' >&2
        exit 1
    fi
    step 'Install Composer 2' sudo php "$installer" --2 --install-dir=/usr/local/bin --filename=composer
fi

if [[ -f composer.lock ]] && ! composer validate --check-lock --no-check-publish --no-check-all --quiet; then
    step 'Refresh snapshot dependencies for composer.json' composer update --no-interaction --no-progress --prefer-dist
else
    step 'Install Composer dependencies' composer install --no-interaction --no-progress --prefer-dist
fi
step 'Check dependency platform requirements' composer check-platform-reqs
step 'Enable repository commit guard' git config core.hooksPath .githooks
printf '\nOrb setup ready: %s\n' "$(php -r 'echo PHP_VERSION;')"
