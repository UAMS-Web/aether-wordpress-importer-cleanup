#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

php -r '
    if (PHP_VERSION_ID < 80400) {
        fwrite(STDERR, "PHP 8.4+ is required; run .agents/setup.\n");
        exit(1);
    }
    require "vendor/autoload.php";
'
printf 'Orb ready: PHP %s and Composer autoload available\n' "$(php -r 'echo PHP_VERSION;')"
