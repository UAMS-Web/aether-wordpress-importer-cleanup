<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
    xmlns:content="http://purl.org/rss/1.0/modules/content/"
    xmlns:wp="http://wordpress.org/export/1.2/">
<channel>
    <title>Synthetic cross-environment corpus</title>
    <item>
        <title><![CDATA[attribute value with double quotes]]></title>
        <content:encoded><![CDATA[<p><img src="a.png" alt='Said she "can see" it'></p>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[attribute value with single quotes]]></title>
        <content:encoded><![CDATA[<p><img src="a.png" alt="It's here"></p>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[less-than inside href]]></title>
        <content:encoded><![CDATA[<p><a href="/?a=1<b">link</a></p>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[leading blank inside href]]></title>
        <content:encoded><![CDATA[<p><a href=" /?id=1&amp;sid=2">link</a></p>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[valueless attribute]]></title>
        <content:encoded><![CDATA[<p><img src="a.png" alt> text</p>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[unclosed inline tags]]></title>
        <content:encoded><![CDATA[<p><b>bold <i>italic</p><p>next]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[block inside inline]]></title>
        <content:encoded><![CDATA[<b><p>Speaker<br>Title</p></b>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[paragraph closed after a table]]></title>
        <content:encoded><![CDATA[<p>Intro<table><tr><td>cell</td></tr></table></p>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[stray end tags]]></title>
        <content:encoded><![CDATA[<p>text</wrong></div></p>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[nested anchors]]></title>
        <content:encoded><![CDATA[<a href="/a">one <a href="/b">two</a></a>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[processing instruction then Office tag closed by its paragraph]]></title>
        <content:encoded><![CDATA[<?xml:namespace prefix = o ns = "urn:schemas-microsoft-com:office:office" /><p><o:p>x</p><p>Body after the processing instruction</p>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[unclosed script]]></title>
        <content:encoded><![CDATA[<p>before</p><script>var x = 1;]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[non-breaking spaces and entities]]></title>
        <content:encoded><![CDATA[<p>Fax:&nbsp;&nbsp;(501) 555-0100 &amp; &lt;tag&gt; &copy; &#8212;</p>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[uppercase tags and attributes]]></title>
        <content:encoded><![CDATA[<P ALIGN="LEFT">Upper <B>case</B> <IMG SRC="a.png" ALT="x"></P>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[table without tbody]]></title>
        <content:encoded><![CDATA[<table border="1"><tr><td>one</td><td>two</td></tr></table>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[embed with a closer]]></title>
        <content:encoded><![CDATA[<embed src="a.swf"></embed>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[list items outside a list]]></title>
        <content:encoded><![CDATA[<li>orphan</li><li>second</li>]]></content:encoded>
    </item>
    <item>
        <title><![CDATA[comment and conditional comment]]></title>
        <content:encoded><![CDATA[<p>a<!-- note --></p><!--[if gte mso 9]><xml>x</xml><![endif]-->]]></content:encoded>
    </item>
